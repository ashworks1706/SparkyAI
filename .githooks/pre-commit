#!/usr/bin/env bash
# Runs the gate for every unit touched by the staged changes. Installed by just hooks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
changed=$(git diff --cached --name-only)
run() { echo "pre-commit: just $1"; just "$1"; }
touched() { grep -qE "$1" <<<"$changed"; }

touched '^(apps/(engine|discord|cli)/|Cargo\.(toml|lock)|scripts/)' && run check-rust
touched '^apps/scraper/' && run check-scraper
touched '^apps/training/' && run check-training
touched '^apps/web/' && run check-web
touched '^docs/ARCHITECTURE\.md$' && run diagrams
:
