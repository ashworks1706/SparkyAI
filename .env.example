# Copy to .env. Secrets, per-machine URLs, and the values docker compose reads.
#
# Everything tunable lives in sparky.toml, which is committed. This file is not: it holds only
# what must not be shared or what differs per machine. Variables here win over sparky.toml.

# Per-deployment.
SPARKY_APP__ENV=development
SPARKY_APP__HTTP_ADDR=0.0.0.0:8080

SPARKY_ENGINE__BASE_URL=http://localhost:8080
SPARKY_ENGINE__SERVICE_TOKEN=change-me

SPARKY_DISCORD__TOKEN=
SPARKY_DISCORD__GUILD_ID=0

# llama-server, OpenAI-compatible. See deploy/inference.
SPARKY_MODEL__BASE_URL=http://localhost:8000/v1
SPARKY_MODEL__API_KEY=

# The chat model that writes tree node summaries during ingestion.
SPARKY_SUMMARY__BASE_URL=http://localhost:8000/v1
SPARKY_SUMMARY__API_KEY=

SPARKY_EMBEDDING__BASE_URL=http://localhost:8001/v1
SPARKY_EMBEDDING__API_KEY=

SPARKY_POSTGRES__URL=postgres://sparky:sparky@localhost:5432/sparky

SPARKY_OBJECT_STORE__ENDPOINT=http://localhost:9000
SPARKY_OBJECT_STORE__ACCESS_KEY=minioadmin
SPARKY_OBJECT_STORE__SECRET_KEY=minioadmin

SPARKY_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317

SPARKY_FIRECRAWL__BASE_URL=http://localhost:3002
SPARKY_FIRECRAWL__API_KEY=

# Legacy single-server MCP form, folded in as a server named playwright. Kept in the
# environment because docker compose overrides it with the service name.
SPARKY_MCP__PLAYWRIGHT_URL=http://localhost:8931/mcp

SPARKY_TRAINING__ENGINE_URL=http://localhost:8080
SPARKY_TRAINING__ENGINE_SERVICE_TOKEN=change-me
SPARKY_TRAINING__PHOENIX_URL=http://localhost:6006

# Read by docker compose and the justfile, not by any app config.
SPARKY_CHAT_GGUF=Qwen/Qwen3-4B-GGUF:Q4_K_M
SPARKY_CHAT_CTX=8192
SPARKY_CHAT_PARALLEL=2
SPARKY_CHAT_NGL=99
SPARKY_EMBED_GGUF=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
SPARKY_EMBED_CTX=4096
SPARKY_EMBED_PARALLEL=2
SPARKY_EMBED_NGL=99

SPARKY_GRAFANA_PASSWORD=admin
SPARKY_FIRECRAWL_DB_PASSWORD=firecrawl-local-only-change-me-32chars
SPARKY_IMAGE_TAG=main
