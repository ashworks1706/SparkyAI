# Copy to .env. Settings use SPARKY_<SECTION>__<KEY>.
#
# Two layers: an optional TOML file (sparky.toml, or SPARKY_CONFIG_FILE) and these variables.
# The environment always wins. Keep secrets here; put lists and nested tables — MCP servers
# above all — in the file. See sparky.example.toml for every knob with its default.

SPARKY_APP__ENV=development
SPARKY_APP__HTTP_ADDR=0.0.0.0:8080
SPARKY_APP__LOG_LEVEL=info,sparky=debug

SPARKY_ENGINE__BASE_URL=http://localhost:8080
SPARKY_ENGINE__SERVICE_TOKEN=change-me

SPARKY_DISCORD__TOKEN=
SPARKY_DISCORD__GUILD_ID=0

SPARKY_MODEL__BASE_URL=http://localhost:8000/v1
SPARKY_MODEL__API_KEY=
SPARKY_MODEL__NAME=Qwen/Qwen3-4B-GGUF:Q4_K_M
SPARKY_MODEL__MAX_TOKENS=2048
# Sampling. Unset fields are left to the server's own defaults.
# SPARKY_MODEL__SAMPLING__TOP_P=0.9
# SPARKY_MODEL__SAMPLING__TOP_K=40
# SPARKY_MODEL__SAMPLING__MIN_P=0.05
# SPARKY_MODEL__SAMPLING__REPEAT_PENALTY=1.05
# SPARKY_MODEL__SAMPLING__SEED=42
# Anything the fields above do not name, as a JSON object. Wins over SAMPLING.
# SPARKY_MODEL__EXTRA_PARAMS_JSON={"dry_multiplier":0.8}

SPARKY_EMBEDDING__BASE_URL=http://localhost:8001/v1
SPARKY_EMBEDDING__API_KEY=
SPARKY_EMBEDDING__NAME=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
SPARKY_EMBEDDING__DIM=1024

SPARKY_POSTGRES__URL=postgres://sparky:sparky@localhost:5432/sparky
SPARKY_POSTGRES__MAX_CONNECTIONS=10
# SPARKY_POSTGRES__ACQUIRE_TIMEOUT_SECS=5

SPARKY_OBJECT_STORE__ENDPOINT=http://localhost:9000
SPARKY_OBJECT_STORE__BUCKET=sparky
SPARKY_OBJECT_STORE__ACCESS_KEY=minioadmin
SPARKY_OBJECT_STORE__SECRET_KEY=minioadmin

SPARKY_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
# SPARKY_TELEMETRY__SAMPLE_RATIO=1.0
# SPARKY_TELEMETRY__SERVICE_NAME=
# SPARKY_TELEMETRY__EXPORT_TIMEOUT_SECS=10

# Legacy single-server MCP form, folded in as a server named `playwright`.
# Prefer [[mcp.servers]] in sparky.toml when there is more than one.
SPARKY_MCP__PLAYWRIGHT_URL=http://localhost:8931/mcp
SPARKY_FIRECRAWL__BASE_URL=http://localhost:3002

# The system prompt. A file path is the usual way; it is read once at boot.
# SPARKY_PROMPT__SYSTEM_FILE=prompts/sparky.md

SPARKY_TRACE__DIR=.sparky/traces
# SPARKY_TRACE__ENABLED=true
# SPARKY_TRACE__MAX_FILE_BYTES=0
# SPARKY_TRACE__RETENTION_HOURS=0

# Agent loop. Every field has a default; see sparky.example.toml.
# SPARKY_AGENT__MAX_STEPS=8
# SPARKY_AGENT__TEMPERATURE=0.3
# SPARKY_AGENT__PROMPT_BUDGET_TOKENS=3000
# SPARKY_AGENT__CHARS_PER_TOKEN=4

# Retrieval tuning.
# SPARKY_RETRIEVAL__TOP_K=6
# SPARKY_RETRIEVAL__CANDIDATES=20
# SPARKY_RETRIEVAL__RRF_K=60.0

# Policy. Roles are a list: SPARKY_POLICY__WRITE_ROLES=[MANAGE_GUILD,officers]
# SPARKY_POLICY__WRITE_ROLES=[MANAGE_GUILD]
# SPARKY_POLICY__CONFIRM_FROM=external_write
# SPARKY_POLICY__ALLOW_AUTHENTICATED_READS=false

# Tools. SPARKY_TOOLS__DISABLED=[browser_click] never registers them.
# SPARKY_TOOLS__DISABLED=[]
# SPARKY_TOOLS__KNOWLEDGE_SEARCH=true
# Live parameterized source queries; needs `just worker` running.
# SPARKY_TOOLS__QUERY_SOURCE=true
# SPARKY_TOOLS__QUERY_TIMEOUT_SECS=90

# HTTP surface.
# SPARKY_HTTP__MAX_BODY_BYTES=1048576
# SPARKY_HTTP__RATE_LIMIT_PER_MIN=0
# SPARKY_HTTP__CONCURRENCY_LIMIT=0
# SPARKY_HTTP__CORS_ORIGINS=[]
# SPARKY_HTTP__SHUTDOWN_GRACE_SECS=10

# Discord bot behaviour.
# SPARKY_BOT__CHANNELS=[]
# SPARKY_BOT__COOLDOWN_SECS=0
# SPARKY_BOT__MAX_MESSAGE_CHARS=2000
# SPARKY_BOT__EDIT_EVERY_MS=1500

SPARKY_CLI__LOG_DIR=.sparky/logs
SPARKY_TRAINING__STATE_DIR=../../.sparky
