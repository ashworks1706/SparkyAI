# Copy to .env. Secrets, per-machine URLs, and the values docker compose reads.
#
# Everything tunable lives in sparky.toml, which is committed. This file is not: it holds only
# what must not be shared or what differs per machine. Variables here win over sparky.toml.

# Per-deployment.
SPARKY_APP__ENV=development
SPARKY_APP__HTTP_ADDR=0.0.0.0:8080

SPARKY_ENGINE__BASE_URL=http://localhost:8080
SPARKY_ENGINE__SERVICE_TOKEN=change-me

SPARKY_DISCORD__TOKEN=
SPARKY_DISCORD__GUILD_ID=0

# llama-server, OpenAI-compatible. See deploy/inference.
# Shared local AI server instead of the compose `model` profile: if the machine runs
# llama-swap (one OpenAI-compatible endpoint for every local model), point both
# BASE_URLs at http://127.0.0.1:8100/v1 and set the API_KEYs to its key. The model
# names in sparky.toml are served under the same names, so nothing else changes.
SPARKY_MODEL__BASE_URL=http://localhost:8000/v1
SPARKY_MODEL__API_KEY=

SPARKY_EMBEDDING__BASE_URL=http://localhost:8001/v1
SPARKY_EMBEDDING__API_KEY=

# The platform holds every store, the knowledge base and the linked accounts. Required: the
# platform root URL and a machine token. The scopes the token needs are listed in the [platform]
# section of sparky.toml. MCP_URL registers the platform tools; leave it unset for none.
SPARKY_PLATFORM__URL=https://platform.example.org
SPARKY_PLATFORM__TOKEN=plat_change-me
# SPARKY_PLATFORM__MCP_URL=http://127.0.0.1:8001/mcp

SPARKY_EVALS__ENGINE_URL=http://localhost:8080
SPARKY_EVALS__ENGINE_SERVICE_TOKEN=change-me

# Read by docker compose and the justfile, not by any app config.
SPARKY_CHAT_GGUF=Qwen/Qwen3-4B-GGUF:Q4_K_M
SPARKY_CHAT_CTX=8192
SPARKY_CHAT_PARALLEL=2
SPARKY_CHAT_NGL=99
SPARKY_EMBED_GGUF=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
SPARKY_EMBED_CTX=4096
SPARKY_EMBED_PARALLEL=2
SPARKY_EMBED_NGL=99

SPARKY_GRAFANA_PASSWORD=admin
SPARKY_IMAGE_TAG=main

# Phoenix trace UI (just phoenix). Empty exports no spans there, and loupe
# (fine-tuning, a separate repo) has nothing to read.
SPARKY_TELEMETRY__PHOENIX_URL=
# Bearer token for a Phoenix that authenticates. Empty sends no Authorization header.
SPARKY_TELEMETRY__PHOENIX_API_KEY=
# Phoenix URL the compose apps use; http://phoenix:6006 when the phoenix profile runs.
SPARKY_PHOENIX_URL=
