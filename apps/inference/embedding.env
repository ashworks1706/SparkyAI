# RunPod pod template environment for embeddings + reranker (one small GPU, e.g. L4 / A10).
# Image: vllm/vllm-openai:latest   Expose: 8001 (embed), 8002 (rerank)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_ARGS=--task embed --port 8001
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_ARGS=--task score --port 8002
VLLM_API_KEY=
HF_TOKEN=
